+    , accessSysRegs:       nullIfBlinded(cap).capReg.perms.hard.access_sys_regs
+    , permitUnseal:        nullIfBlinded(cap).capReg.perms.hard.permit_unseal
+    , permitCCall:         nullIfBlinded(cap).capReg.perms.hard.permit_ccall
+    , permitSeal:          nullIfBlinded(cap).capReg.perms.hard.permit_seal
+    , permitStoreLocalCap: nullIfBlinded(cap).capReg.perms.hard.permit_store_ephemeral_cap
+    , permitStoreCap:      nullIfBlinded(cap).capReg.perms.hard.permit_store_cap
+    , permitLoadCap:       nullIfBlinded(cap).capReg.perms.hard.permit_load_cap
+    , permitStore:         nullIfBlinded(cap).capReg.perms.hard.permit_store
+    , permitLoad:          nullIfBlinded(cap).capReg.perms.hard.permit_load
+    , permitExecute:       nullIfBlinded(cap).capReg.perms.hard.permit_execute
+    , global:              nullIfBlinded(cap).capReg.perms.hard.non_ephemeral };
+  function setHardPerms (cap, perms);
