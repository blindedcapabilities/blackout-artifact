+    cap.capReg.isCapability = tag;
+    return cap;
+  endfunction
+
+  // blinded bit
+  function setBlinded (x);
+    x.isBlinded = True;
+    return x;
+  endfunction
+  function getBlinded (x) = x.isBlinded;
+  function getAddrUnsafe (x);
+    BlindedCapReg res = x;
+    res.isBlinded = False;
+    return getAddr(res);
+  endfunction
+
+  // capability flags
+  //////////////////////////////////////////////////////////////////////////////
+  function getFlags (cap) = nullIfBlinded(cap).capReg.flags;
+  function setFlags (cap, flags);
+    cap.capReg.flags = flags;
+    return cap;
+  endfunction
