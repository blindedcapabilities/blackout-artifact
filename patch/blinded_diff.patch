+
+
+
+
+  bool runOnModule(Module &Mod) override {
+    M = &Mod;
+    const DataLayout &DL = Mod.getDataLayout();
+    unsigned AllocaAS = DL.getAllocaAddrSpace();
+
+    // Early abort if we aren't using capabilities on the stack
+    if (!DL.isFatPointer(AllocaAS))
+      return false;
+
+    LLVMContext &C = M->getContext();
+    I8CapTy = Type::getInt8PtrTy(C, AllocaAS);
+    SizeTy = Type::getIntNTy(C, DL.getIndexSizeInBits(AllocaAS));
+
+    bool Modified = false;
+    for (Function &F : Mod)
+      Modified |= runOnFunction(F);
+
+    return Modified;
+  }
+
+  bool runOnFunction(Function &F) {
+    //F.dump();
+    LLVMContext &C = F.getContext();
+    Allocas.clear();
+    visit(F);
+
+    if (Allocas.empty())
+        return false;
+
+    SmallVector<AllocaInst*, 16> initiallyBlinded;
+    for (BasicBlock &BB : F) {
+      for (Instruction &I : BB) {
+        if (auto *AI = dyn_cast<AllocaInst>(&I)) {
+          if (hasBlindedAttribute(AI, C)) {
+              initiallyBlinded.push_back(AI);
+          }
+        }
+      }
+    }
+
+    std::queue<AllocaInst*> worklist;
+    for (AllocaInst* AI : initiallyBlinded) {
+      worklist.push(AI);
+    }
+
+    // A helper lambda to mark an alloca as blinded if not already
+    auto markBlindedIfNeeded = [&](AllocaInst *NewAI) {
+      if (!hasBlindedAttribute(NewAI, C)) {
+        LLVMContext &Ctx = NewAI->getContext();
+        MDNode *BlindedMeta = MDNode::get(Ctx, MDString::get(Ctx, "blinded"));
+          NewAI->setMetadata("clang.var.blinded", BlindedMeta);
+          worklist.push(NewAI);
+        }
+    };
+
+          
+    while (!worklist.empty()) {
+      AllocaInst *Cur = worklist.front();
+      worklist.pop();
+
+      for (User *U : Cur->users()) {
+        // GEP analysis 
+        if (auto *GEP = dyn_cast<GetElementPtrInst>(U)) {
+          for (User *GEPUser : GEP->users()) {
+            if (auto *Store = dyn_cast<StoreInst>(GEPUser)) {
+              Value *Ptr = Store->getPointerOperand();
+              if (auto *B = dyn_cast<AllocaInst>(Ptr)) {
+                markBlindedIfNeeded(B);
+              }
+            } else if (auto *Load = dyn_cast<LoadInst>(GEPUser)) {
+              for (User *LoadUser : Load->users()) {
+                if (auto *Store = dyn_cast<StoreInst>(LoadUser)) {
+                  Value *Ptr = Store->getPointerOperand();
+                  if (auto *B = dyn_cast<AllocaInst>(Ptr)) {
+                    markBlindedIfNeeded(B);
+                  }
+                }
+              }
+            }
+          }
+        } 
+        // direct store analysis
+        else if (auto *Store = dyn_cast<StoreInst>(U)) {
+          Value *Ptr = Store->getPointerOperand();
+          Value *Underlying = getUnderlyingObject(Ptr, 6);
+          if (auto *B = dyn_cast<AllocaInst>(Underlying)) {
+              markBlindedIfNeeded(B);
+          }
+        } 
+        // direct load analysis
+        else if (auto *Load = dyn_cast<LoadInst>(U)) {
+          for (User *LoadUser : Load->users()) {
+            if (auto *Store = dyn_cast<StoreInst>(LoadUser)) {
+                Value *Ptr = Store->getPointerOperand();
+                if (auto *B = dyn_cast<AllocaInst>(Ptr)) {
+                  markBlindedIfNeeded(B);
+                }
+            }
+          }
+        }
+      }
+    }
+    //F.dump(); 
+    return true; 
+  }
+    // // **Return Value Analysis**
+    // for (BasicBlock &BB : F) {
+    //     for (Instruction &I : BB) {
+    //         if (auto *Ret = dyn_cast<ReturnInst>(&I)) {
