+class CheriBlindedAnalysis : public ModulePass, public InstVisitor<CheriBlindedAnalysis> {
+
+  Module *M;
+  llvm::SmallVector<AllocaInst *, 16> Allocas;
+  Type *I8CapTy;
+  Type *SizeTy;
+
+public:
+  static char ID;
+  CheriBlindedAnalysis() : ModulePass(ID) {
+    initializeCheriBlindedAnalysisPass(*PassRegistry::getPassRegistry());
+  }
+  StringRef getPassName() const override { return "CHERI blinded stack allocations"; }
+  void visitAllocaInst(AllocaInst &AI) {
+    Allocas.push_back(&AI);
+}
+
+bool hasBlindedAttribute(llvm::AllocaInst* AI, llvm::LLVMContext &Context) {
+  if (!AI) return false;
+
+  unsigned blindedID = Context.getMDKindID("clang.var.blinded");
+
+  if (llvm::MDNode* N = AI->getMetadata(blindedID)) {
+    return true;
+  }
+  return false;
+}
+
+// bool traceToBlinded(Value *V, llvm::LLVMContext &Context) {
+//     // A queue (worklist) of Values to process
+//     SmallVector<Value *, 8> WorkList;
+//     // A set to avoid re-processing Values
+//     SmallSet<Value *, 8> Visited;
+
+//     // Initialize the queue with the starting value
+//     WorkList.push_back(V);
+//     Visited.insert(V);
+
