+
+//         // 2) If Current is an Instruction, we examine its operands (the sources feeding into it)
+//         if (auto *I = dyn_cast<Instruction>(Current)) {
+
+//             for (auto &Op : I->operands()) {
+//                 Value *OpVal = Op.get();
+//                 if (!Visited.count(OpVal)) {
+//                     errs() << "  Adding operand to queue: " << *OpVal << "\n";
+//                     WorkList.push_back(OpVal);
+//                     Visited.insert(OpVal);
