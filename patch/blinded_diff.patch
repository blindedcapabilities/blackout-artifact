diff --git a/clang/lib/AST/TypeLoc.cpp b/clang/lib/AST/TypeLoc.cpp
index 65c1aa1e734e..bd43ba016d2a 100644
--- a/clang/lib/AST/TypeLoc.cpp
+++ b/clang/lib/AST/TypeLoc.cpp
@@ -31,6 +31,29 @@
 using namespace clang;
 
 static const unsigned TypeLocMaxDataAlign = alignof(void *);
+unsigned TypeLoc::getBlindedMask() const {
+  auto TL = TypeLoc(*this);
+  uint64_t UninitMask = 0;
+  uint64_t NumIndirections = 0;
+  
+  while (TL) {
+    if (auto ATL = TL.getAsAdjusted<AttributedTypeLoc>()) {
+      if (ATL.getAttrKind() == attr::AnnotateType) {
+        const AnnotateTypeAttr *ATA = ATL.getAttrAs<AnnotateTypeAttr>();
+        if (ATA->getAnnotation().compare("blinded") == 0) {
+          UninitMask |= (1ull << NumIndirections);
+        }
+      }
+    }
+    
+    if (TL.getType()->isAnyPointerType() || TL.getType()->isArrayType()) {
+      NumIndirections++;
+    }
+    TL = TL.getNextTypeLoc();
+  }
+  
+  return UninitMask;
+}
 
 //===----------------------------------------------------------------------===//
 // TypeLoc Implementation
