+void CodeGenModule::AddGlobalBlindedAnnotations(const ValueDecl *D,
+                                                llvm::GlobalValue *GV) {
+  if (const auto *VD = dyn_cast<VarDecl>(D)) {
+    if (auto *SI = VD->getTypeSourceInfo()) {
+      if (auto TL = SI->getTypeLoc()) {
+        uint64_t BlindedMask = TL.getBlindedMask();
+        if (BlindedMask) {
+          if (auto *GVVar = dyn_cast<llvm::GlobalVariable>(GV)) {
+            GVVar->setSection(".blinded");
+          }
+        }
+      }
+    }
+  }
